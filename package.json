{
  "name": "advanced-software-development-lab1-svg-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "高级软件开发技术 Lab1 — SVG CLI editor",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "cli": "tsx src/bootstrap/Main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/bootstrap/Main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts --no-error-on-unmatched-pattern",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "benchmark": "node --expose-gc --import tsx scripts/Benchmark.ts",
    "visual:check": "tsx scripts/VisualCheck.ts",
    "release:check": "tsx scripts/ReleaseCheck.ts"
  },
  "dependencies": {
    "fast-xml-parser": "5.11.2"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  }
}
